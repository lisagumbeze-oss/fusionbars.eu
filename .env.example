# ==============================================================================
# FUSION MUSHROOM BARS EU - ENVIRONMENT CONFIGURATION
# Production Target: Vercel | Runtime: Node.js 22 LTS | Framework: Next.js 16
# ==============================================================================
#
# IMPORTANT SECURITY POLICY:
# - NEVER commit real credentials, private keys, wallet addresses, or bank accounts.
# - NEVER use development fallbacks in a production environment.
# - Production boots in fail-safe mode if any critical environment variable is absent.
#
# ==============================================================================
# 1. ENVIRONMENT MODE
# ==============================================================================
NODE_ENV="development" # "development" | "preview" | "production"

# ==============================================================================
# 2. SITE & CANONICAL DOMAIN
# ==============================================================================
# Apex canonical domain (Strict HTTPS, www redirected to apex)
SITE_URL="https://fusionbars.eu"
NEXT_PUBLIC_SITE_URL="https://fusionbars.eu"

# ==============================================================================
# 3. DATABASE (POSTGRESQL + PRISMA ON VERCEL SERVERLESS)
# ==============================================================================
# Pooled connection string for serverless API routes (e.g. Supabase / Neon / PgBouncer, port 6543)
DATABASE_URL="postgresql://user:password@pooler.region.postgres.provider.com:6543/fusion_eu?pgbouncer=true&connection_limit=1"

# Direct non-pooled connection for running Prisma CLI migrations (npx prisma migrate deploy)
DIRECT_URL="postgresql://user:password@db.region.postgres.provider.com:5432/fusion_eu"

# ==============================================================================
# 4. CRYPTOGRAPHIC SECURITY & SESSION SECRETS
# ==============================================================================
# Minimum 32-character high-entropy cryptographic strings.
# Generate via: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHAR_HMAC_SECRET"
ORDER_LOOKUP_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHAR_LOOKUP_SECRET"
AUTH_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHAR_AUTH_SECRET"

# ==============================================================================
# 5. TRANSACTIONAL EMAIL (RESEND / POSTMARK / SENDGRID / SMTP)
# ==============================================================================
# Provider options: "mock" (dev/test) | "resend" | "postmark" | "smtp"
EMAIL_PROVIDER="mock"
EMAIL_PROVIDER_KEY="re_mock_development_api_key"
EMAIL_FROM="Fusion Mushroom Bars EU <sales@fusionbars.eu>"
EMAIL_REPLY_TO="sales@fusionbars.eu"
EMAIL_OPS_INBOX="sales@fusionbars.eu"

# ==============================================================================
# 6. PRIVATE OBJECT STORAGE (PAYMENT PROOFS - S3 COMPATIBLE)
# ==============================================================================
# Provider options: "mock" (dev/test) | "s3" | "cloudflare_r2"
STORAGE_PROVIDER="mock"
STORAGE_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
STORAGE_BUCKET="fusion-eu-private-payment-proofs"
STORAGE_REGION="eu-central-1"
STORAGE_ACCESS_KEY="AWS_OR_R2_ACCESS_KEY_ID"
STORAGE_SECRET_KEY="AWS_OR_R2_SECRET_ACCESS_KEY"

# ==============================================================================
# 7. DISTRIBUTED RATE LIMITING (UPSTASH / REDIS REST API)
# ==============================================================================
# Leave empty in development to utilize the local memory sliding window.
# In production, configure Upstash Redis REST credentials for distributed state.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==============================================================================
# 8. PAYMENT CHANNELS - BANK WIRE (SEPA / IBAN)
# ==============================================================================
# Business bank coordinates for European B2C/B2B transfers.
# NOTE: Supplied only upon final banking clearance.
BANK_ACCOUNT_HOLDER=""
BANK_NAME=""
BANK_IBAN=""
BANK_BIC_SWIFT=""

# ==============================================================================
# 9. PAYMENT CHANNELS - CRYPTOCURRENCY (COLD STORAGE ONLY)
# ==============================================================================
# Verified multi-signature or hardware cold-storage addresses.
# Leave empty or set to test placeholder in development.
CRYPTO_BTC_ADDRESS=""
CRYPTO_BTC_NETWORK="Bitcoin Mainnet"

# Inactive by default; enabled only after compliance sign-off
CRYPTO_USDT_ADDRESS=""
CRYPTO_USDT_NETWORK="Ethereum (ERC-20)"

CRYPTO_ETH_ADDRESS=""
CRYPTO_ETH_NETWORK="Ethereum Mainnet"

# ==============================================================================
# 10. OBSERVABILITY & ERROR TRACKING
# ==============================================================================
MONITORING_DSN=""
LOG_LEVEL="info" # "debug" | "info" | "warn" | "error"

# ==============================================================================
# 11. LEGAL ENTITY CONFIGURATION (PLACEHOLDERS UNTIL CORPORATE REGISTRATION)
# ==============================================================================
LEGAL_COMPANY_NAME="[LEGAL_COMPANY_NAME_PENDING]"
LEGAL_COMPANY_REG_NUMBER="[REGISTRATION_NUMBER_PENDING]"
LEGAL_VAT_NUMBER="[VAT_NUMBER_PENDING]"
LEGAL_REGISTERED_OFFICE="[REGISTERED_OFFICE_ADDRESS_PENDING]"
LEGAL_CONTACT_EMAIL="sales@fusionbars.eu"
LEGAL_SUPERVISORY_AUTHORITY="[SUPERVISORY_AUTHORITY_PENDING]"
